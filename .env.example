# Escolha o modo de autenticação: LDAP ou LOCAL
AUTH_MODE=LOCAL ou LDAP

# Arquivo: .env.example
DB_USER=seu_usuario_aqui
DB_PASSWORD=sua_senha_segura
DB_NAME=nome_do_banco

LDAP_SERVER=ip_do_seu_servidor_AD
LDAP_DOMAIN=SEU_DOMINIO
LDAP_SEARCH_BASE=dc=empresa,dc=com

# Configurações da Aplicação
SECRET_KEY=gere_uma_chave_aleatoria_aqui